  "tests": [
    {
      "description": "Verifies white starts, only correct color draggable, and turn switches after committed move.",
      "lastRunAt": 1789647916145,
      "lastRunDurationMs": 1227,
      "lastRunFramesExecuted": 15,
      "lastRunStatus": "passed",
      "name": "Turn-based play: white starts and alternates",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Start Game');",
        "await harness.stepFrames(5);",
        "",
        "// White starts",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === true, 'WhiteTurn starts True (white moves first)');",
        "",
        "const wp = harness.getObjects('White_Pawn_1')[0];",
        "const bp = harness.getObjects('Black_Pawn_1')[0];",
        "harness.assert(wp.behaviors['Draggable'].act === true, 'White piece is draggable on white turn');",
        "harness.assert(bp.behaviors['Draggable'].act === false, 'Black piece is NOT draggable on white turn');",
        "",
        "// Drag White_Pawn_1 from square (6,0) forward one square to (5,0)",
        "const startX = wp.centerX;",
        "const startY = wp.centerY;",
        "const targetX = 261.75 + 45.125;",
        "const targetY = 431.25 + 45.125;",
        "",
        "harness.touchStart(1, startX, startY);",
        "await harness.stepFrames(2);",
        "harness.touchMove(1, targetX, targetY);",
        "await harness.stepFrames(2);",
        "harness.touchEnd(1);",
        "await harness.stepFrames(5);",
        "",
        "// The white pawn should have committed the move to square (0,5)",
        "const wpAfter = harness.getObjects('White_Pawn_1')[0];",
        "const gx = harness.getObjectVariable(wpAfter.id, 'Grid_X');",
        "const gy = harness.getObjectVariable(wpAfter.id, 'Grid_Y');",
        "harness.assert(gx?.value === 0 && gy?.value === 5, 'White pawn committed the move to square (0,5)');",
        "",
        "// Turn should now be black's",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === false, 'WhiteTurn becomes False after white moves');",
        "",
        "const bp2 = harness.getObjects('Black_Pawn_1')[0];",
        "const wp2 = harness.getObjects('White_Pawn_1')[0];",
        "harness.assert(bp2.behaviors['Draggable'].act === true, 'Black piece is draggable after white moves');",
        "harness.assert(wp2.behaviors['Draggable'].act === false, 'White piece is NOT draggable after white moves');"
      ]
    },
    {
      "description": "Verifies turns alternate indefinitely: white, black, white, black over three full cycles.",
      "lastRunAt": 1789633982761,
      "lastRunDurationMs": 973,
      "lastRunFramesExecuted": 60,
      "lastRunStatus": "passed",
      "name": "Turn alternation over multiple cycles",
      "type": "gameplay",
      "source": [
        "async function dragPiece(harness, objName, tx, ty) {",
        "  const p = harness.getObjects(objName)[0];",
        "  harness.touchStart(1, p.centerX, p.centerY);",
        "  await harness.stepFrames(2);",
        "  harness.touchMove(1, tx, ty);",
        "  await harness.stepFrames(2);",
        "  harness.touchEnd(1);",
        "  await harness.stepFrames(5);",
        "}",
        "",
        "await harness.goToScene('Start Game');",
        "await harness.stepFrames(5);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === true, 'White starts');",
        "",
        "// Cycle 1",
        "await dragPiece(harness, 'White_Pawn_1', 306.875, 476.375);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === false, 'After white move 1: black turn');",
        "harness.assert(harness.getObjects('Black_Pawn_1')[0].behaviors['Draggable'].act === true, 'After white move 1: black draggable');",
        "",
        "await dragPiece(harness, 'Black_Pawn_1', 306.875, 205.625);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === true, 'After black move 1: white turn');",
        "harness.assert(harness.getObjects('White_Pawn_2')[0].behaviors['Draggable'].act === true, 'After black move 1: white draggable');",
        "",
        "// Cycle 2 (this is where it broke before)",
        "await dragPiece(harness, 'White_Pawn_2', 397.125, 476.375);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === false, 'After white move 2: black turn');",
        "harness.assert(harness.getObjects('Black_Pawn_2')[0].behaviors['Draggable'].act === true, 'After white move 2: black draggable');",
        "",
        "await dragPiece(harness, 'Black_Pawn_2', 397.125, 205.625);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === true, 'After black move 2: white turn');",
        "",
        "// Cycle 3 — prove alternation continues indefinitely",
        "await dragPiece(harness, 'White_Pawn_3', 487.375, 476.375);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === false, 'After white move 3: black turn');",
        "await dragPiece(harness, 'Black_Pawn_3', 487.375, 205.625);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === true, 'After black move 3: white turn');"
      ]
    },
    {
      "description": "Verifies captures delete the piece from the field and play continues normally.",
      "lastRunAt": 1789295222551,
      "lastRunDurationMs": 1304,
      "lastRunFramesExecuted": 89,
      "lastRunStatus": "passed",
      "name": "Capture removes piece from board",
      "type": "gameplay",
      "source": [
        "async function dragPiece(harness, objName, tx, ty) {",
        "  const p = harness.getObjects(objName)[0];",
        "  harness.touchStart(1, p.centerX, p.centerY);",
        "  await harness.stepFrames(2);",
        "  harness.touchMove(1, tx, ty);",
        "  await harness.stepFrames(2);",
        "  harness.touchEnd(1);",
        "  await harness.stepFrames(5);",
        "}",
        "",
        "await harness.goToScene('Start Game');",
        "await harness.stepFrames(5);",
        "",
        "// Build up to a capture: White_Pawn_1 to (0,4), Black_Pawn_2 to (1,3)",
        "await dragPiece(harness, 'White_Pawn_1', 306.875, 476.375);",
        "await dragPiece(harness, 'Black_Pawn_2', 397.125, 205.625);",
        "await dragPiece(harness, 'White_Pawn_1', 306.875, 386.125);",
        "await dragPiece(harness, 'Black_Pawn_2', 397.125, 295.875);",
        "",
        "// White captures Black_Pawn_2 on (1,3)",
        "await dragPiece(harness, 'White_Pawn_1', 397.125, 295.875);",
        "await harness.stepFrames(20);",
        "",
        "harness.assert(harness.getObjects('Black_Pawn_2').length === 0, 'Captured piece is removed from the playing field');",
        "harness.assert(harness.getSceneVariable('CapturedBlack')?.value === 1, 'CapturedBlack counter = 1');",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === false, 'Turn passes to black after the capture');",
        "const wp = harness.getObjects('White_Pawn_1')[0];",
        "harness.assert(harness.getObjectVariable(wp.id, 'Grid_X')?.value === 1 && harness.getObjectVariable(wp.id, 'Grid_Y')?.value === 3, 'Capturer occupies the square');",
        "",
        "// Game continues normally after the capture: black pawn (0,1)->(0,2), then white pawn (1,6)->(1,5)",
        "await dragPiece(harness, 'Black_Pawn_1', 306.875, 205.625);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === true, 'Black can move after a capture; turn returns to white');",
        "const bp1 = harness.getObjects('Black_Pawn_1')[0];",
        "harness.assert(harness.getObjectVariable(bp1.id, 'Grid_Y')?.value === 2, 'Black pawn actually moved');",
        "",
        "await dragPiece(harness, 'White_Pawn_2', 397.125, 476.375);",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === false, 'White can move; alternation continues after captures');"
      ]
    },
    {
      "description": "Verifies Fool's Mate triggers the Checkmate_Message sprite and freezes the game.",
      "lastRunAt": 1789643690639,
      "lastRunDurationMs": 1697,
      "lastRunFramesExecuted": 222,
      "lastRunStatus": "passed",
      "name": "Checkmate message on Fool's Mate",
      "type": "gameplay",
      "source": [
        "async function dragPiece(harness, objName, tx, ty) {",
        "  const p = harness.getObjects(objName)[0];",
        "  harness.touchStart(1, p.centerX, p.centerY);",
        "  await harness.stepFrames(2);",
        "  harness.touchMove(1, tx, ty);",
        "  await harness.stepFrames(2);",
        "  harness.touchEnd(1);",
        "  await harness.stepFrames(5);",
        "}",
        "",
        "await harness.goToScene('Start Game');",
        "await harness.stepFrames(5);",
        "",
        "const sprite = () => harness.getObjects('Checkmate_Message')[0];",
        "harness.assert(sprite()?.hidden === true, 'Checkmate_Message is invisible at game start');",
        "",
        "// Fool's Mate: 1.f3 e5 2.g4 Qh4#",
        "await dragPiece(harness, 'White_Pawn_6', 758.125, 476.375);   // f3",
        "await dragPiece(harness, 'Black_Pawn_5', 667.875, 295.875);   // e5",
        "await dragPiece(harness, 'White_Pawn_7', 848.375, 386.125);   // g4",
        "harness.assert(sprite()?.hidden === true, 'Sprite still hidden while the game is only progressing (no check)');",
        "await dragPiece(harness, 'Black_Queen_1', 938.625, 386.125);  // Qh4# — checkmate",
        "await harness.stepFrames(180);",
        "",
        "harness.assert(sprite()?.hidden === false, 'Checkmate_Message appears on checkmate');",
        "harness.assert(harness.getSceneVariable('GameOver')?.value === true, 'GameOver flag set on checkmate');",
        "const wp = harness.getObjects('White_Pawn_6')[0];",
        "harness.assert(wp.behaviors['Draggable'].act === false, 'No pieces can be dragged after checkmate');",
        "harness.assert(harness.getSceneVariable('CapturedBlack')?.value === 0, 'No pieces were lost to the scan');",
        "const bpq = harness.getObjects('Black_Queen_1')[0];",
        "harness.assert(Math.abs(bpq.centerX - 938.625) < 6 && Math.abs(bpq.centerY - 386.125) < 6, 'Mating queen stays on h4');"
      ]
    },
    {
      "description": "Verifies escapes from check by capture and by retreat work, with no false checkmate.",
      "lastRunAt": 1789295191515,
      "lastRunDurationMs": 1752,
      "lastRunFramesExecuted": 358,
      "lastRunStatus": "passed",
      "name": "Check escapes work",
      "type": "gameplay",
      "source": [
        "async function dragPiece(harness, objName, tx, ty) {",
        "  const p = harness.getObjects(objName)[0];",
        "  harness.touchStart(1, p.centerX, p.centerY);",
        "  await harness.stepFrames(2);",
        "  harness.touchMove(1, tx, ty);",
        "  await harness.stepFrames(2);",
        "  harness.touchEnd(1);",
        "  await harness.stepFrames(5);",
        "}",
        "",
        "await harness.goToScene('Start Game');",
        "await harness.stepFrames(5);",
        "const sprite = () => harness.getObjects('Checkmate_Message')[0];",
        "",
        "await dragPiece(harness, 'White_Pawn_5', 667.875, 386.125);   // 1.e4",
        "await dragPiece(harness, 'Black_Pawn_5', 667.875, 295.875);   // 1...e5",
        "await dragPiece(harness, 'White_Queen_1', 938.625, 295.875);  // 2.Qh5",
        "await dragPiece(harness, 'Black_Horse_1', 487.375, 205.625);  // 2...Nc6",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === true, 'Nc6 committed');",
        "",
        "await dragPiece(harness, 'White_Queen_1', 758.125, 115.375);  // 3.Qxf7+ CHECK by capture",
        "await harness.stepFrames(100);",
        "harness.assert(sprite()?.hidden === true, 'No false checkmate when an escape exists');",
        "harness.assert(harness.getSceneVariable('GameOver')?.value === false, 'Game not frozen on a normal check');",
        "const q = harness.getObjects('White_Queen_1')[0];",
        "harness.assert(harness.getObjectVariable(q.id, 'Grid_X')?.value === 5 && harness.getObjectVariable(q.id, 'Grid_Y')?.value === 1, 'Queen on f7 gives check');",
        "",
        "await dragPiece(harness, 'Black_King_1', 758.125, 115.375);   // 3...Kxf7 escape by CAPTURE",
        "await harness.stepFrames(40);",
        "const bk = harness.getObjects('Black_King_1')[0];",
        "harness.assert(harness.getObjectVariable(bk.id, 'Grid_X')?.value === 5 && harness.getObjectVariable(bk.id, 'Grid_Y')?.value === 1, 'King captured the checker (escape by capture works)');",
        "harness.assert(harness.getObjects('White_Queen_1').length === 0, 'Checking queen removed');",
        "harness.assert(sprite()?.hidden === true, 'Sprite still hidden after the escape');",
        "",
        "await dragPiece(harness, 'White_Bishop_2', 487.375, 386.125); // 4.Bc4+ CHECK",
        "await harness.stepFrames(100);",
        "harness.assert(sprite()?.hidden === true, 'No false checkmate after Bc4+');",
        "harness.assert(harness.getSceneVariable('WhiteTurn')?.value === false, 'Black to move after Bc4+');",
        "",
        "await dragPiece(harness, 'Black_King_1', 667.875, 25.125);    // 4...Ke8 escape by RETREAT",
        "await harness.stepFrames(40);",
        "const bk2 = harness.getObjects('Black_King_1')[0];",
        "harness.assert(harness.getObjectVariable(bk2.id, 'Grid_X')?.value === 4 && harness.getObjectVariable(bk2.id, 'Grid_Y')?.value === 0, 'King retreated to e8 (escape by retreat works)');",
        "harness.assert(sprite()?.hidden === true, 'Sprite remains hidden — no false checkmate');",
        "harness.assert(harness.getSceneVariable('GameOver')?.value === false, 'Game continues normally');"
      ]
    }
